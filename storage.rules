rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check user authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to validate image files
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Helper function to check file size (max 5MB)
    function isValidSize() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    // Helper function to validate image constraints (for blog and profile images)
    function isValidImage() {
      return isImage() && isValidSize();
    }

    // Blog content (large HTML) - ownership by path: blog-content/{userId}/{fileName}
    // Only the owning user can create/update/delete; anyone can read (public content).
    match /blog-content/{userId}/{fileName} {
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      allow read: if true;
    }

    // Legacy path blog-content/{fileName} - read-only (no ownership; existing content still loads)
    match /blog-content/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ── Owner folders ────────────────────────────────────────────────────
    // Anyone can create an account, so "signed in" is not a permission. For
    // team-managed media (blog images, builder photos, audio, audio covers) a
    // user may only write inside a folder named after their own uid; everyone
    // can read. Paths are built by src/integrations/firebase/storagePaths.ts.
    // Files uploaded before owner folders (flat paths) are read-only from the
    // app; admins manage them in the Firebase console.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Blog images (and profile pictures uploaded by the profile page)
    match /blog-images/{imageId} {
      allow read: if true;
      allow write: if false;
    }
    match /blog-images/{userId}/{imageId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // Profile avatars - users can manage their own, anyone can read
    // Path: profile-avatars/{userId}/{filename}
    match /profile-avatars/{userId}/{imageId} {
      // Users can create their own avatar
      allow create: if isAuthenticated() && 
                      request.auth.uid == userId && 
                      isValidImage();
      
      // Anyone can read profile avatars (needed to display user avatars)
      allow read: if true;
      
      // Users can update/replace their own avatars
      allow update: if isAuthenticated() && 
                     request.auth.uid == userId && 
                     isValidImage();
      
      // Users can delete their own avatars
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Builder profile photos
    match /builder-photos/{imageId} {
      allow read: if true;
      allow write: if false;
    }
    match /builder-photos/{userId}/{imageId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // Public uploads directory - for shared/published content
    match /public/{document=**} {
      // Anyone can read
      allow read: if true;
      // Prevent writes to this path (read-only)
      allow write: if false;
    }

    // Temporary uploads - for processing (user-specific)
    match /temp/{userId}/{document=**} {
      // Only authenticated users can access their own temp files
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Audio episode cover images — audio-thumbnails/{lang}/{uid}/{file}
    match /audio-thumbnails/{lang}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /audio-thumbnails/{lang}/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if lang in ['en', 'fr'] && isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // Audio episodes — audio/{lang}/{uid}/{file}. Public read for the player.
    function isValidAudio() {
      return request.resource.contentType.matches('audio/.*')
          && request.resource.size <= 200 * 1024 * 1024; // 200 MB max
    }

    match /audio/{lang}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /audio/{lang}/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if lang in ['en', 'fr'] && isOwner(userId) && isValidAudio();
      allow delete: if isOwner(userId);
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
