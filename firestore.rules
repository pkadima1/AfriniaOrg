rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────
    function getUserRole() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isContributor() {
      return isSignedIn() && getUserRole() in ['admin', 'contributor'];
    }

    // ── User profiles ─────────────────────────────────────────────────────
    match /user_profiles/{userId} {
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email;
      allow read:   if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Bilingual blog post rules ─────────────────────────────────────────
    // Public read pattern: using `allow read` with resource.data.status lets
    // Firestore permit a query ONLY when the query itself filters to published
    // (e.g. where('status','==','published')). The query in blogService.ts always
    // includes that filter for public routes. Contributors bypass via isContributor().
    // This replaces the broken allow list + request.query.limit pattern which
    // evaluated to false when no explicit limit() was set in the query.

    match /posts_en/{postId} {
      allow read:   if resource.data.status == 'published' || isContributor();
      allow create: if isContributor();
      allow update: if isAdmin()
                    || isContributor()
                    || (isSignedIn() && resource.data.author_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /posts_fr/{postId} {
      allow read:   if resource.data.status == 'published' || isContributor();
      allow create: if isContributor();
      allow update: if isAdmin()
                    || isContributor()
                    || (isSignedIn() && resource.data.author_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Legacy blog_posts collection (read-only for migration reference) ──
    match /blog_posts/{postId} {
      allow read:   if resource.data.status == 'published' || isContributor();
      allow create: if isContributor();
      allow update: if isAdmin()
                    || isContributor()
                    || (isSignedIn() && resource.data.author_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Audio episodes (bilingual) ────────────────────────────────────────
    // Same pattern as blog posts: public can list/get published episodes;
    // contributors see all. audioService.ts always queries with
    // where('status','==','published') so the rule is satisfied.

    match /audio_en/{episodeId} {
      allow read:   if resource.data.status == 'published' || isContributor();
      allow create: if isContributor();
      allow update: if isAdmin() || isContributor();
      allow delete: if isAdmin();
    }

    match /audio_fr/{episodeId} {
      allow read:   if resource.data.status == 'published' || isContributor();
      allow create: if isContributor();
      allow update: if isAdmin() || isContributor();
      allow delete: if isAdmin();
    }

    // ── Comments (bilingual) ──────────────────────────────────────────────
    // comments_en / comments_fr are PUBLIC: anyone can read them. They must
    // therefore never contain personal data. A commenter's optional email is
    // stored separately in comment_contacts (admin-only), written in the same
    // batch as the comment — see commentService.addCommentToPost.
    // Anyone may create a comment (no account needed), but only with exactly
    // the expected fields and sizes. Update/delete: admins only (moderation).
    // Keep limits in sync with COMMENT_LIMITS in src/integrations/firebase/types.ts.

    function isValidComment(lang) {
      let d = request.resource.data;
      return d.keys().hasAll(['post_slug', 'lang', 'name', 'message', 'created_at', 'updated_at'])
          && d.keys().hasOnly(['post_slug', 'lang', 'name', 'message', 'parent_id', 'created_at', 'updated_at', 'email'])
          && d.lang == lang
          && d.post_slug is string && d.post_slug.size() > 0 && d.post_slug.size() <= 300
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
          && (!('parent_id' in d) || d.parent_id == null
              || (d.parent_id is string && d.parent_id.size() <= 64))
          && d.created_at is string && d.created_at.size() <= 40
          && d.updated_at == d.created_at
          // TEMP: browsers still running the pre-fix bundle send `email: null`
          // when the field is empty. Accept only null so those comments keep
          // working, while any real address is rejected here. Remove the
          // 'email' key from hasOnly once old bundles are gone (they are
          // replaced on the next page load; index.html is never cached).
          && (!('email' in d) || d.email == null);
    }

    match /comments_en/{commentId} {
      allow read:           if true;
      allow create:         if isValidComment('en');
      allow update, delete: if isAdmin();
    }

    match /comments_fr/{commentId} {
      allow read:           if true;
      allow create:         if isValidComment('fr');
      allow update, delete: if isAdmin();
    }

    // ── Commenter contact emails (private) ───────────────────────────────
    // Document id == the comment's id. Readable by admins only.
    // Create is allowed ONLY in the same batch that creates the comment
    // (!exists before, existsAfter after) — so nobody can attach an email to
    // someone else's existing comment. Never updated; admins may delete.
    match /comment_contacts/{commentId} {
      function commentPath(lang) {
        return /databases/$(database)/documents/$('comments_' + lang)/$(commentId);
      }
      allow read:   if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'comment_id', 'lang', 'post_slug', 'created_at'])
                    && request.resource.data.keys().hasAll(['email', 'comment_id', 'lang', 'post_slug', 'created_at'])
                    && request.resource.data.comment_id == commentId
                    && request.resource.data.lang in ['en', 'fr']
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.post_slug is string
                    && request.resource.data.post_slug.size() <= 300
                    && request.resource.data.created_at is string
                    && request.resource.data.created_at.size() <= 40
                    && !exists(commentPath(request.resource.data.lang))
                    && existsAfter(commentPath(request.resource.data.lang))
                    && getAfter(commentPath(request.resource.data.lang)).data.post_slug
                         == request.resource.data.post_slug;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Legacy comments (historical data, no longer used by the app) ──────
    // Some documents contain commenter emails, so reads are admin-only.
    match /comments/{commentId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Newsletter subscribers ────────────────────────────────────────────
    // All writes now go through the Netlify subscribe/unsubscribe functions,
    // which use Firebase Admin SDK and bypass these rules. Browser clients
    // no longer write to this collection directly — create is therefore
    // denied at the rule level to prevent unauthenticated direct writes.
    // Admin reads and deletes remain for the subscriber management panel.
    match /newsletter_subscribers/{docId} {
      allow create: if false;
      allow read:   if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ── Contact form submissions ──────────────────────────────────────────
    // All writes go through the send-contact Netlify function, which uses the
    // Firebase Admin SDK and bypasses these rules. Browser clients never write
    // to this collection directly — create is denied at the rule level.
    // Admins can read, mark as read/archived (update), and delete.
    match /contact_messages/{docId} {
      allow create: if false;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Builder profiles (bilingual, same split as posts_en/posts_fr) ─────
    // Published docs are readable by anyone; contributors can read/write
    // everything (drafts included). EN and FR are independent documents —
    // adapted content, not a translation pair.
    match /builders_en/{builderId} {
      allow read:   if resource.data.status == 'published' || isContributor();
      allow create: if isContributor();
      allow update: if isContributor();
      allow delete: if isAdmin();
    }

    match /builders_fr/{builderId} {
      allow read:   if resource.data.status == 'published' || isContributor();
      allow create: if isContributor();
      allow update: if isContributor();
      allow delete: if isAdmin();
    }

    // ── Site config (popup settings, social links, etc.) ─────────────────
    // Public read: the subscribe popup fetches its template config without auth.
    // Admin-only write: only admins can change popup content or toggle settings.
    match /site_config/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Deny everything else (catch-all) ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
